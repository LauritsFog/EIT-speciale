
@article{astala_calderons_2006,
	title = {Calderón’s inverse conductivity problem in the plane},
	volume = {163},
	issn = {0003-486X},
	url = {http://annals.math.princeton.edu/2006/163-1/p05},
	doi = {10.4007/annals.2006.163.265},
	abstract = {We show that the Dirichlet to Neumann map for the equation ∇·σ∇u = 0 in a two-dimensional domain uniquely determines the bounded measurable conductivity σ. This gives a positive answer to a question of A. P. Caldero´n from 1980. Earlier the result has been shown only for conductivities that are suﬃciently smooth. In higher dimensions the problem remains open.},
	pages = {265--299},
	number = {1},
	journaltitle = {Annals of Mathematics},
	shortjournal = {Ann. Math.},
	author = {Astala, Kari and Païvärinta, Lassi},
	urldate = {2025-09-02},
	date = {2006-01-01},
	langid = {english},
	file = {PDF:/Users/laurits/Zotero/storage/JLWZWEK8/Astala and Païvärinta - 2006 - Calderón’s inverse conductivity problem in the plane.pdf:application/pdf},
}

@article{hamilton_direct_2014,
	title = {A Direct Reconstruction Method for Anisotropic Electrical Impedance Tomography},
	volume = {30},
	issn = {0266-5611, 1361-6420},
	url = {http://arxiv.org/abs/1402.1117},
	doi = {10.1088/0266-5611/30/7/075007},
	abstract = {A novel computational, non-iterative and noise-robust reconstruction method is introduced for the planar anisotropic inverse conductivity problem. The method is based on bypassing the unstable step of the reconstruction of the values of the isothermal coordinates on the boundary of the domain. Non-uniqueness of the inverse problem is dealt with by recovering the unique isotropic conductivity that can be achieved as a deformation of the measured anisotropic conductivity by {\textbackslash}emph\{isothermal coordinates\}. The method shows how isotropic D-bar reconstruction methods have produced reasonable and informative reconstructions even when used on {EIT} data known to come from anisotropic media, and when the boundary shape is not known precisely. Furthermore, the results pave the way for regularized anisotropic {EIT}. Key aspects of the approach involve D-bar methods and inverse scattering theory, complex geometrical optics solutions, and quasi-conformal mapping techniques.},
	pages = {075007},
	number = {7},
	journaltitle = {Inverse Problems},
	shortjournal = {Inverse Problems},
	author = {Hamilton, Sarah Jane and Lassas, Matti and Siltanen, Samuli},
	urldate = {2025-09-02},
	date = {2014-06-01},
	eprinttype = {arxiv},
	eprint = {1402.1117 [math]},
	keywords = {Mathematics - Analysis of {PDEs}, Mathematics - Numerical Analysis},
	file = {Full Text PDF:/Users/laurits/Zotero/storage/N79LYCVY/Hamilton m.fl. - 2014 - A Direct Reconstruction Method for Anisotropic Electrical Impedance Tomography.pdf:application/pdf;Snapshot:/Users/laurits/Zotero/storage/MVM4IT4B/1402.html:text/html},
}

@article{henkin_inverse_2010,
	title = {On an inverse problem for anisotropic conductivity in the plane},
	volume = {26},
	issn = {0266-5611, 1361-6420},
	url = {http://arxiv.org/abs/1003.1880},
	doi = {10.1088/0266-5611/26/9/095011},
	abstract = {Let \${\textbackslash}hat {\textbackslash}Omega {\textbackslash}subset {\textbackslash}mathbb R{\textasciicircum}2\$ be a bounded domain with smooth boundary and \${\textbackslash}hat {\textbackslash}sigma\$ a smooth anisotropic conductivity on \${\textbackslash}hat {\textbackslash}Omega\$. Starting from the Dirichlet-to-Neumann operator \${\textbackslash}Lambda\_\{{\textbackslash}hat {\textbackslash}sigma\}\$ on \${\textbackslash}partial {\textbackslash}hat {\textbackslash}Omega\$, we give an explicit procedure to find a unique domain \${\textbackslash}Omega\$, an isotropic conductivity \${\textbackslash}sigma\$ on \${\textbackslash}Omega\$ and the boundary values of a quasiconformal diffeomorphism \$F:{\textbackslash}hat {\textbackslash}Omega {\textbackslash}to {\textbackslash}Omega\$ which transforms \${\textbackslash}hat {\textbackslash}sigma\$ into \${\textbackslash}sigma\$.},
	pages = {095011},
	number = {9},
	journaltitle = {Inverse Problems},
	shortjournal = {Inverse Problems},
	author = {Henkin, Gennadi and Santacesaria, Matteo},
	urldate = {2025-09-02},
	date = {2010-09-01},
	eprinttype = {arxiv},
	eprint = {1003.1880 [math]},
	keywords = {Mathematics - Analysis of {PDEs}, Mathematical Physics, Mathematics - Mathematical Physics},
	file = {Full Text PDF:/Users/laurits/Zotero/storage/E3UMLLPR/Henkin and Santacesaria - 2010 - On an inverse problem for anisotropic conductivity in the plane.pdf:application/pdf;Snapshot:/Users/laurits/Zotero/storage/2D9NRZZ4/1003.html:text/html},
}

@article{kuusela_coupled_2024,
	title = {A Coupled Double-Layer Electrical Impedance Tomography-Based Sensing Skin for Pressure and Leak Detection},
	volume = {24},
	rights = {https://creativecommons.org/licenses/by/4.0/},
	issn = {1424-8220},
	url = {https://www.mdpi.com/1424-8220/24/13/4134},
	doi = {10.3390/s24134134},
	abstract = {There is an extensive need for surface sensors for applications such as tactile sensing for robotics, damage and strain detection for structural health monitoring and leak detection for buried structures. One type of surface sensor is electrical impedance tomography ({EIT})-based sensing skins, which use electrically conductive coatings applied on the object’s surface to monitor physical or chemical phenomena on the surface. In this article, we propose a sensing skin with two electrically coupled layers separated by an insulator. Based on electrical measurements, the spatial distribution of the electrical coupling between the layers is estimated. This coupling is sensitive to both the pressure distribution on the surface and water entering between the layers through a leak. We present simulations and experimental studies to evaluate the feasibility of the proposed method for pressure sensing and leak detection. The results support the feasibility of the proposed method for both of these applications.},
	pages = {4134},
	number = {13},
	journaltitle = {Sensors},
	shortjournal = {Sensors},
	author = {Kuusela, Petri and Seppänen, Aku},
	urldate = {2025-09-02},
	date = {2024-06-26},
	langid = {english},
	file = {Fuldtekst:/Users/laurits/Zotero/storage/H8NJZL6Y/Kuusela and Seppänen - 2024 - A Coupled Double-Layer Electrical Impedance Tomography-Based Sensing Skin for Pressure and Leak Dete.pdf:application/pdf},
}

